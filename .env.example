# -------------------------------------------------------
# AutoEdit-Lite — Environment Variables
# -------------------------------------------------------
# 1. Copy this file and rename it to:  .env
# 2. Replace "your_key_here" with your real API key
# 3. Get your key at: https://console.anthropic.com/
# -------------------------------------------------------

ANTHROPIC_API_KEY=your_key_here

# Optional but recommended for Marathi, Hindi, and Indian English transcription.
# Get your key at: https://dashboard.sarvam.ai/
SARVAM_API_KEY=your_sarvam_key_here
